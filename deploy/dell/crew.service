# The crew service on the home server. Keys come from Azure Key Vault (kv-i2-dev-bpwlfu) through the
# machine's Azure Arc identity, straight into memory; nothing is stored on disk.
[Unit]
Description=GreenplateAi crew service
After=network-online.target himdsd.service
Wants=network-online.target

[Service]
User=crew
Group=crew
SupplementaryGroups=himds
WorkingDirectory=/opt/greenplate-crew
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs src/kitchen/serve.ts
Restart=always
RestartSec=5
Environment=PORT=8787 NODE_ENV=production AZURE_KEYVAULT=kv-i2-dev-bpwlfu
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/greenplate-crew

[Install]
WantedBy=multi-user.target
