# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Required: a long random string the iPhone app sends with every request.
CREW_APP_TOKEN=
# Voice (ElevenLabs): the key, and the chosen voice's ID (not secret).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Thinking (Meta Model API, Muse Spark).
MODEL_API_KEY=
# The household's GreenplateAi kitchen (MCP bearer token for that household).
GREENPLATE_MCP_TOKEN=
# 1 lets the crew save changes after you say yes (needs a Plus or Pro household).
CREW_CAN_WRITE=0
